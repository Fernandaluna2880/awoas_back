# =====================================================================
# GeoTour API - Variables de entorno del backend
# Copiar a .env (o exportar en el entorno) antes de ejecutar Spring Boot.
# Spring Boot NO lee .env por si mismo: usar docker compose o su IDE.
# =====================================================================

# Servidor
SERVER_PORT=8080

# Base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/geotour
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JWT: debe ser HEXADECIMAL y representar al menos 32 bytes (64 caracteres)
JWT_SECRET_KEY=5f4dcc3b5aa765d61d8327deb882cf995f4dcc3b5aa765d61d8327deb882cf99
JWT_EXPIRATION_MS=86400000

# OpenWeatherMap (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Cache del clima (minutos)
CLIMA_CACHE_TTL_MINUTES=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Administrador inicial (creado por DataInitializer si no existe)
ADMIN_EMAIL=admin@geotour.com
ADMIN_PASSWORD=Admin1234!
